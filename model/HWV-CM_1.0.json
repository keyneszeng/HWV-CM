  "processing_pipeline": [
    "独立获取当事人自愿同意",
    "安全风险筛查；风险时暂停联席调解",
    "分别收集双方叙述且标注来源",
    "拆分已确认事实/争议事实/主观解释",
    "按本人确认资料检索相关价值和需求",
    "产出至少两种可修正的冲突成因假设",
    "双方分别确认或纠正 AI 假设",
    "给出非强制且可操作的协商选项",
    "双方自愿制定约定并跟踪结果",
    "用户同意后才写回个人和关系模型"
  ],
  "inference_policy": {
    "never_infer_sensitive_from_text_without_opt_in": true,
    "never_share_private_profile_across_persons_without_permission": true,
    "unknown_should_be_unknown": true,
    "no_single_compatibility_score": true,
    "reasoning_is_hypothesis_not_truth": true
  },
  "acceptance_gates": {
    "scientific": [
      "内容效度",
      "重测信度",
      "结构/聚合/区分效度",
      "跨语言测量等价性",
      "公平与偏差评估",
      "真实场景外部效度"
    ],
    "safety": [
