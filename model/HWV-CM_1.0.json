      "加密及最小化留存",
      "独立私密空间",
      "伤害情境拒绝强制调解",
      "敏感分类及跨境规则"
    ],
    "product": [
      "双方感到被公正对待",
      "事实与解释分离",
      "建议可操作",
      "用户能纠正假设",
      "有中长期结果跟踪"
    ]
  },
